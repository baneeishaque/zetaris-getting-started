# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real credentials.
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Optional: path to the Zetaris-supplied driver JAR. Used only when refreshing
# lib/ with scripts/install-zetaris-driver.sh.
ZETARIS_JDBC_JAR=
